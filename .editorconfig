root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.{cs,csproj,props,targets}]
indent_size = 4

[*.{ts,tsx,js,jsx,json,css,yml,yaml}]
indent_size = 2
end_of_line = lf

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.sh]
end_of_line = lf

# Test projects: names are sentences, not identifiers. Readability of a failing
# test name beats the naming convention.
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA5394.severity = none

[bench/**.cs]
dotnet_diagnostic.CA1707.severity = none
