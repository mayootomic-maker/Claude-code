{
  "name": "golem",
  "version": "0.1.0",
  "private": true,
  "description": "An AI that plays Minecraft like a person does.",
  "type": "module",
  "bin": {
    "golem": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:server": "node e2e/server.mjs",
    "e2e": "node e2e/run.mjs",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "minecraft-data": "^3.116.0",
    "mineflayer": "^4.38.0",
    "mineflayer-pathfinder": "^2.4.5",
    "vec3": "^0.1.10"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "flying-squid": "^1.12.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
