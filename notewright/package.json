{
  "name": "notewright",
  "version": "0.1.0",
  "private": true,
  "description": "A beat maker built around 808s and hi-hat rolls, whose songs are plain text",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node e2e/drive.mjs",
    "check:engine": "node e2e/engine-check.mjs",
    "check:songs": "node e2e/song-check.mjs",
    "check:drums": "node e2e/drum-balance.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run check:engine && npm run check:songs && npm run e2e",
    "render": "node scripts/render.mjs",
    "analyse": "node scripts/analyse.mjs",
    "desktop": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "preact": "^10.24.3"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.5.0",
    "playwright-core": "^1.48.0",
    "typescript": "^5.6.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "keywords": [
    "daw",
    "trap",
    "808",
    "beat-maker",
    "web-audio",
    "sequencer"
  ]
}
