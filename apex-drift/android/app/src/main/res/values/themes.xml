<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Every surface that can show before the first WebGL frame is the
         game's own background, so launch never flashes white. -->
    <style name="Theme.ApexDrift" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/apex_bg</item>
        <item name="android:colorBackground">@color/apex_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.ApexDrift.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/apex_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.ApexDrift</item>
        <item name="android:windowBackground">@color/apex_bg</item>
    </style>
</resources>
