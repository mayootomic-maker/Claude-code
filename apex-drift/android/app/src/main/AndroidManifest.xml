<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Three.js renders through WebGL 2, which needs GLES 3.0 underneath. -->
    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="true" />

    <!-- 3.0 is fully offline: the game is served from the APK's own assets.
         No INTERNET, and no storage permission: saveImage goes through
         MediaStore, which needs none on API 29+. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- appCategory="game" is what exempts the app from Android 16's
         large-screen rule that ignores orientation locks on tablets and
         foldables for apps targeting API 36. -->
    <application
        android:allowBackup="true"
        android:appCategory="game"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="false"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ApexDrift.Starting"
        tools:targetApi="33">

        <!-- configChanges keeps a fold, resize or keyboard event from
             destroying the activity, which would reload the WebView and
             drop the race in progress. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
