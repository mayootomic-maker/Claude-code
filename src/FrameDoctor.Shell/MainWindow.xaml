<Window x:Class="FrameDoctor.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="FrameDoctor"
        Width="1440" Height="900"
        MinWidth="1100" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="#0B0E13">

  <!--
    Background is set to the frontend's own base surface colour rather than left at the system
    default. Without it the window paints white for the moment before the web view has content,
    and a white flash on launch is the single most noticeable thing about a dark application.
  -->

  <Grid>
    <wv2:WebView2 x:Name="Host" DefaultBackgroundColor="#0B0E13" />

    <!--
      Shown only when the web view could not be created, and replaced by real content otherwise.
      It states the reason rather than a generic failure, because the reason here is almost
      always a missing WebView2 runtime, which the user can fix.
    -->
    <Border x:Name="StartupFailure"
            Visibility="Collapsed"
            Background="#0B0E13"
            Padding="48">
      <StackPanel VerticalAlignment="Center" MaxWidth="560">
        <TextBlock Text="FrameDoctor could not start its display"
                   Foreground="#E8EDF4"
                   FontFamily="Segoe UI Variable Text, Segoe UI"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16" />
        <TextBlock x:Name="StartupFailureDetail"
                   Foreground="#9BA6B7"
                   FontFamily="Segoe UI Variable Text, Segoe UI"
                   FontSize="14"
                   TextWrapping="Wrap"
                   LineHeight="22" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
